# Copy this file to a new file named .env, then fill in the real values.

# In OnePage CRM: Profile icon -> Apps and Integrations -> API -> Configuration.
ONEPAGECRM_ENDPOINT=https://app.onepagecrm.com/api/v3
ONEPAGECRM_USER_ID=your_user_id_here
ONEPAGECRM_API_KEY=your_api_key_here

# Use "http" for ChatGPT / remote MCP. Use "stdio" for local MCP apps that launch this server.
MCP_TRANSPORT=http
PORT=3000

# Optional: only use this if your MCP client or hosting proxy can send:
# Authorization: Bearer your_long_random_token
# MCP_BEARER_TOKEN=
